    "topic_model": "Structural Topic Modeling (STM), an extension of Latent Dirichlet Allocation that conditions topic prevalence on document metadata",
    "covariates": [
      "employment status",
      "review year",
      "review rating"
    ],
    "k_selection": "semantic coherence and exclusivity across candidate models from 4 to 10 topics, combined with the author's reading of the topics",
    "validation": "semantic coherence and exclusivity scores, plus manual labelling and interpretation against at least twenty reviews per topic"
